import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

// Alfa Romeo 690T approximation (tuned: open exhaust, smoother idle, more power)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

private node alfa_690t_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 55 * units.cc;                       // was 58.1 (CR ~9.8:1)
    input intake_runner_volume: 180 * units.cc;
    input intake_runner_cross_section_area: 1.55 * units.inch * 1.55 * units.inch;
    input exhaust_runner_volume: 55 * units.cc;
    input exhaust_runner_cross_section_area: 1.65 * units.inch * 1.65 * units.inch;
    input flow_attenuation: 1.0;                               // was 1.0 (better port flow)
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 65 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 125 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 190 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 250 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 295 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 325 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 345 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 355 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 360 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 48 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 95 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 145 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 195 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 235 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 265 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 285 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 295 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 300 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,
        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

private node alfa_690t_camshaft {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 114 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 0.55 * units.inch;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;
    output intake_cam_1: _intake_cam_1;
    output exhaust_cam_1: _exhaust_cam_1;

    camshaft_parameters params(advance: advance, base_radius: base_radius)
    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile)

    label rot360(360 * units.deg)

    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * units.deg)
        .add_lobe(rot360 - exhaust_lobe_center + 480 * units.deg)
        .add_lobe(rot360 - exhaust_lobe_center + 240 * units.deg)
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * units.deg)
        .add_lobe(rot360 + intake_lobe_center + 480 * units.deg)
        .add_lobe(rot360 + intake_lobe_center + 240 * units.deg)

    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + 630 * units.deg)
        .add_lobe(rot360 - exhaust_lobe_center + 390 * units.deg)
        .add_lobe(rot360 - exhaust_lobe_center + 150 * units.deg)
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + 630 * units.deg)
        .add_lobe(rot360 + intake_lobe_center + 390 * units.deg)
        .add_lobe(rot360 + intake_lobe_center + 150 * units.deg)
}

public node alfa_romeo_690t {
    alias output __out: engine;

    engine engine(
        name: "Alfa Romeo 690T 2.9 V6 Twin Turbo",
        starter_torque: 100 * units.lb_ft,
        starter_speed: 500 * units.rpm,
        redline: 7400 * units.rpm,
        throttle_gamma: 1.0,                 // was 1.8 (more throttle at part-open)
        hf_gain: 0.0015,                     // was 0.003 (less high-freq "crack")
        noise: 0.12,                         // was 0.25
        jitter: 0.05,                        // was 0.15 (smoother idle)
        simulation_frequency: 10000,         // was 6000 (more accurate pulses/power)
        fuel: fuel(max_burning_efficiency: 1.2)   // stands in for turbo boost
    )

    wires wires()

    // 86.5 mm bore, 82.0 mm stroke, 2,891 cc total displacement.
    label stroke(82.0 * units.mm)
    label bore(86.5 * units.mm)
    // Rod length is an estimate; it is not a published 690T specification.
    label rod_length(5.5 * units.inch)
    label rod_mass(535 * units.g)
    label compression_height(1.0 * units.inch)
    label crank_mass(22.7 * units.kg)
    label flywheel_mass(12.0 * units.kg)    // was 13.6
    label flywheel_radius(6.0 * units.inch)

    label crank_moment(disk_moment_of_inertia(mass: crank_mass, radius: stroke))
    label flywheel_moment(disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius))
    label other_moment(disk_moment_of_inertia(mass: 6.0 * units.kg, radius: 1.0 * units.cm))

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 4.0 * units.lb_ft,   // was 5.0
        moment_of_inertia: crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 45 * units.deg
    )

    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 120 * units.deg)
    rod_journal rj2(angle: 240 * units.deg)
    c0.add_rod_journal(rj0).add_rod_journal(rj1).add_rod_journal(rj2)

    piston_parameters piston_params(
        mass: (414 + 152) * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(mass: rod_mass, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    // Much bigger plenum / flow = the main power gain (turbo-like air supply).
    // If idle rpm now sits too high or low, tweak idle_throttle_plate_position only
    // (closer to 1.0 = less idle air).
    intake intake(
        plenum_volume: 2.0 * units.L,                 // was 1.325
        plenum_cross_section_area: 60.0 * units.cm2,  // was 20
        intake_flow_rate: k_carb(600.0),              // was 400
        runner_flow_rate: k_carb(330.0),              // was 250
        runner_length: 6.0 * units.inch,              // was 4
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9973,         // was 0.9952 (compensates bigger intake)
        throttle_gamma: 1.0,
        velocity_decay: 0.5
    )

    // Open, free-flowing exhaust (less restriction, less muffling).
    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1400.0),       // was 1000
        primary_tube_length: 12.0 * units.inch, // was 20
        primary_flow_rate: k_carb(700.0),       // was 600
        velocity_decay: 1.0
    )

    exhaust_system exhaust0(
        es_params,
        length: 30 * units.inch,                // was 42 (shorter = less boomy/muffled)
        audio_volume: 0.8,                      // was 0.25
        impulse_response: ir_lib.default_0      // was mild_exhaust_0_reverb (muffled/reverby)
    )
    exhaust_system exhaust1(
        es_params,
        length: 30 * units.inch,
        audio_volume: 0.8,
        impulse_response: ir_lib.default_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    label spacing(4.5 * units.inch)
    cylinder_bank b0(bank_params, angle: -45 * units.deg)
    cylinder_bank b1(bank_params, angle: 45 * units.deg)

    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: spacing * 2
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 1.0,
            primary_length: spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.0,
            primary_length: 0 * units.inch
        )
        .set_cylinder_head(alfa_690t_head(
            intake_camshaft: camshaft.intake_cam_0,
            exhaust_camshaft: camshaft.exhaust_cam_0
        ))

    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.0,
            primary_length: spacing * 2
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 1.0,
            primary_length: spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 1.0,
            primary_length: 0 * units.inch
        )
        .set_cylinder_head(alfa_690t_head(
            intake_camshaft: camshaft.intake_cam_1,
            exhaust_camshaft: camshaft.exhaust_cam_1,
            flip_display: true
        ))

    engine.add_cylinder_bank(b0).add_cylinder_bank(b1)
    engine.add_crankshaft(c0)

    // Slightly more lift/duration for power; kept mild so idle stays smooth.
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 232 * units.deg,   // was 222
        gamma: 1.0,
        lift: 440 * units.thou,                 // was 400
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 232 * units.deg,   // was 226
        gamma: 1.0,
        lift: 400 * units.thou,                 // was 300
        steps: 100
    )

    alfa_690t_camshaft camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 117 * units.deg,
        exhaust_lobe_center: 112 * units.deg,
        base_radius: 0.75 * units.inch
    )

    // Smoothed: the old curve dropped to 24 deg at 5000 rpm, costing power.
    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 16 * units.deg)
        .add_sample(500 * units.rpm, 18 * units.deg)
        .add_sample(950 * units.rpm, 20 * units.deg)
        .add_sample(1000 * units.rpm, 20 * units.deg)
        .add_sample(2000 * units.rpm, 25 * units.deg)
        .add_sample(3000 * units.rpm, 30 * units.deg)
        .add_sample(4000 * units.rpm, 31 * units.deg)
        .add_sample(5000 * units.rpm, 30 * units.deg)
        .add_sample(6000 * units.rpm, 29 * units.deg)
        .add_sample(7000 * units.rpm, 28 * units.deg)
        .add_sample(7400 * units.rpm, 28 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 7400 * units.rpm,
        limiter_duration: 0.08
    )

    // The cylinder-to-wire assignments above map this phase pattern to
    // the 690T firing order 1-6-3-4-2-5 (90/150-degree alternating gaps).
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire6, 150 * units.deg)
        .connect_wire(wires.wire3, 240 * units.deg)
        .connect_wire(wires.wire4, 390 * units.deg)
        .connect_wire(wires.wire2, 480 * units.deg)
        .connect_wire(wires.wire5, 630 * units.deg)

    engine.add_ignition_module(ignition_module)
}

private node alfa_690t_vehicle {
    alias output __out: vehicle(
        mass: 1660 * units.kg,
        drag_coefficient: 0.32,
        cross_sectional_area: (72 * units.inch) * (56 * units.inch),
        diff_ratio: 3.27,
        tire_radius: 13.0 * units.inch,
        rolling_resistance: 0.015 * 1660 * units.kg * 9.81
    );
}

private node alfa_690t_transmission {
    alias output __out:
        transmission(max_clutch_torque: 700 * units.lb_ft)
            .add_gear(4.71)
            .add_gear(3.14)
            .add_gear(2.10)
            .add_gear(1.67)
            .add_gear(1.29)
            .add_gear(1.00)
            .add_gear(0.84)
            .add_gear(0.67);
}

public node main {
    run(
        engine: alfa_romeo_690t(),
        transmission: alfa_690t_transmission(),
        vehicle: alfa_690t_vehicle()
    )
}

main()
